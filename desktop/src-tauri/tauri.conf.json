{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tiffin",
  "version": "0.5.0",
  "identifier": "fyi.tiffin.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tiffin",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: photo: http://photo.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQ0NBNzQ1Q0VDRjZGM0EKUldRNmI4L09SYWZNd1Q5dWJMSUNuVkxNekhNb2RwMi85ck1rd1VnM3Ezb0pVWjJCVlUzVTRSUEoK",
      "endpoints": ["https://github.com/iamaharsh/Tiffin/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tiffin",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
